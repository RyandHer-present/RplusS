# Public configuration. This file IS committed.
#
# These values are compiled into the deployed bundle, which anyone can read.
# That is expected: Row Level Security is what protects the data, not secrecy.
# Anything genuinely secret belongs in Supabase's secret store, never here.
VITE_SUPABASE_URL=https://jpikfeprrgdrvcdwdhnr.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_kzFDT4ctiAZ-SEBo_pjYJQ_ZPF55nDC

# Backblaze credentials live server-side in the media-sign function.
VITE_STORAGE_READY=true

# Discord webhook for the "someone opened the site" alert. Public, like
# everything else here — it is compiled into the bundle and anyone who opens
# the site can read it. Anyone holding it can post to the channel or delete the
# webhook, so if it gets abused, make a new one in Discord and paste it here.
# To switch the alerts off: delete the webhook in Discord, or blank this line
# and redeploy.
VITE_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1540587298620575794/yoJJLhTT0Yp2XTjlb0-7wLLheJu3YG9IKSuVOnT1eyxF2_v3xVldsxpKpt6weDl_hgku
